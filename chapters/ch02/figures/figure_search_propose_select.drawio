<mxfile host="app.diagrams.net" type="device">
  <diagram name="search-propose-select" id="search-propose-select">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Searching for a better artifact: propose and select" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="820" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="Search takes the current best and the signal's feedback, proposes new variants, and keeps the one that scores higher; the method is a pluggable slot, and SPO is this chapter's choice" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1040" height="18" as="geometry"/></mxCell>

        <mxCell id="bc1" value="Act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="706" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc2" value="Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="778" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc3" value="Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;fontSize=10;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc4" value="Apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="922" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bce1" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc1" target="bc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bce2" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc2" target="bc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bce3" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc3" target="bc4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bccap" value="the step introduced here" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="706" y="104" width="272" height="16" as="geometry"/></mxCell>

        <mxCell id="in1" value="&lt;b&gt;Current best artifact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;the live-champion prompt we are trying to beat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.4;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="232" height="76" as="geometry"/></mxCell>
        <mxCell id="in2" value="&lt;b&gt;Signal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;scores each variant (the judge&lt;br&gt;we built in the last section)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.4;fontColor=#1F3D35;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="232" height="88" as="geometry"/></mxCell>

        <mxCell id="sig" value="Search: propose variants, then select a winner  (the method is a pluggable slot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=4;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="520" height="300" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;SPO&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot;&gt;mutate the best, keep it if the judge prefers it&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;this chapter (next figures map and open up this box)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="196" width="468" height="50" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;GEPA&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;reflect on the run, evolve a population  (chapter 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="254" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;DGM&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;keep an archive of diverse variants  (chapter 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="302" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;Evolutionary / random&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;broader, less guided search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="350" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="sigcap" value="Every method exposes the same two moves: propose variants, then select the winner." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#3A6B5E;" vertex="1" parent="1"><mxGeometry x="326" y="404" width="468" height="30" as="geometry"/></mxCell>

        <mxCell id="gm" value="&lt;b&gt;Selected variant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;the winner Search keeps&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9B4434&quot;&gt;a new artifact version&lt;br&gt;parent pointer to its source&lt;br&gt;immutable: never an edit in place&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="858" y="176" width="252" height="200" as="geometry"/></mxCell>
        <mxCell id="gmcap" value="Apply promotes it and the archive keeps the lineage, so the rest of the loop never sees which method ran." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7A2A1C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="858" y="386" width="252" height="64" as="geometry"/></mxCell>

        <mxCell id="ein1" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="in1" target="sig"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ein2" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.62;" edge="1" parent="1" source="in2" target="sig"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="esel" value="select" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="sig" target="gm"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="foot" value="This chapter builds SPO, the simplest method that works: mutate, score, accept. The next figure places it on a cost-and-reach map, and the one after opens up the box. GEPA and DGM in chapter 3 drop into the same propose-and-select shape and return the same kind of selected variant." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1080" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
