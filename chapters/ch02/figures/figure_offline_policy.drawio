<mxfile host="app.diagrams.net" type="device">
  <diagram name="offline-policy" id="offline-policy">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="The ImproverPolicy: when rounds run, and how a winner is chosen" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="900" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="One config object gates the loop. The teal fields are the three section 2.4 sets; the rest keep their defaults until you need them." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1060" height="18" as="geometry"/></mxCell>

        <mxCell id="p1" value="&lt;b&gt;When rounds run&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F3D35&quot;&gt;&lt;b&gt;schedule&lt;/b&gt; = MANUAL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888780&quot; style=&quot;font-size:10px&quot;&gt;or INTERVAL (every N sec) / CONTINUOUS&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;interval_sec, jitter_sec&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;max_in_flight&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;quiesce_on_empty_eval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.4;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="60" y="104" width="320" height="280" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;How much each round costs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F3D35&quot;&gt;&lt;b&gt;questions_per_round&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#888780&quot; style=&quot;font-size:10px&quot;&gt;(None = all)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;budget_per_round (tokens, $, wall-clock)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;max_concurrent_questions&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;max_iterations_per_question&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;max_tool_calls_per_question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.4;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="410" y="104" width="320" height="280" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;How a winner is chosen&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F3D35&quot;&gt;&lt;b&gt;promote_threshold_win_rate&lt;/b&gt; = 0.5&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888780&quot; style=&quot;font-size:10px&quot;&gt;the bar a candidate must clear to be promotable&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;mode: OFFLINE / ONLINE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5F5E5A&quot;&gt;auto_promote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.4;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="760" y="104" width="300" height="280" as="geometry"/></mxCell>

        <mxCell id="callout" value="&lt;b&gt;Promotable is not the same as live.&lt;/b&gt;  Clearing promote_threshold_win_rate marks a candidate as worth promoting, but OFFLINE mode still waits for a human to call promote(). ONLINE mode (chapter 8) is what auto-promotes on a win, and only for prompt and memory artifacts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.8;fontColor=#7A2A1C;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="412" width="1000" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
