<mxfile host="app.diagrams.net" type="device">
  <diagram name="offline-code-flow" id="offline-code-flow">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Section 2.4 in code: assemble, attach, drive" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="760" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="The shape of main_async: open the archive, build the agent, compose the primitives, wrap them in an improver, then drive the rounds by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1080" height="18" as="geometry"/></mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Observe&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;attach_console_renderer(verbose=True)&lt;br&gt;stream every step to the terminal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.3;fontColor=#2C2C2A;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="240" height="104" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Archive + seed&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;archive = open_archive()&lt;br&gt;seed = await get_or_create_seed(archive)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.3;fontColor=#7A2A1C;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="346" y="100" width="240" height="104" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;Agent(system_prompt=seed,&lt;br&gt;tools=[retrieve], model=...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.3;fontColor=#2C2C2A;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="642" y="100" width="240" height="104" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Compose primitives&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;SwapAndAgree(PairwiseJudge(...))&lt;br&gt;SPO(...)&lt;br&gt;FixedEvalSet(...)&lt;br&gt;ImproverPolicy(...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.5;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="200" height="104" as="geometry"/></mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Build the improver&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;OfflineImprover(agent, signal, search,&lt;br&gt;archive, eval_source, policy, seed_fallback)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.5;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Attach and drive&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;agent.attach_improver(improver)&lt;br&gt;await improver.start()&lt;br&gt;for _ in range(N): await improver.trigger_round()&lt;br&gt;await improver.stop()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.3;fontColor=#2C2C2A;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="340" height="104" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Read the result&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;improver.status &amp;#8594; rounds_completed,&lt;br&gt;last_round_result (scores, promoted)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.3;fontColor=#2C2C2A;arcSize=8;align=center;verticalAlign=top;spacingTop=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="290" height="104" as="geometry"/></mxCell>

        <mxCell id="e12" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="250"/><mxPoint x="200" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="e56" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.4;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="callout" value="Steps 2 and 4-5 are the new ideas: the archive holds the seed and every later version, and the four primitives snap into one OfflineImprover. Steps 1, 3, 6, and 7 are ordinary setup, run, and read-back." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="1050" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
