<mxfile host="app.diagrams.net" type="device">
  <diagram name="search-spo-method" id="search-spo-method">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="How SPO works: mutate, score, accept" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="700" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="SPO is the search loop of figure 2.8 made specific: mutate is the propose step, score is the measure step, and accept is the select step, with no labeled answers anywhere" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1060" height="18" as="geometry"/></mxCell>

        <mxCell id="inCur" value="&lt;b&gt;Current best prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;the one to beat (genesis on round 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.4;fontColor=#7A2A1C;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="84" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="inSamp" value="&lt;b&gt;A few sample questions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;as few as three&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="84" width="250" height="56" as="geometry"/></mxCell>

        <mxCell id="S1" value="&lt;b&gt;1. Mutate&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;(the Propose step)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F3D35&quot;&gt;rewrite the current best prompt&lt;br&gt;into a candidate, hinted by the&lt;br&gt;last round's feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="S2" value="&lt;b&gt;2. Score&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;(the Measure step)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F3D35&quot;&gt;run BOTH prompts on the sample questions; the pairwise&lt;br&gt;judge picks a winner per question and tallies wins / losses,&lt;br&gt;keeping the feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="360" y="184" width="400" height="124" as="geometry"/></mxCell>
        <mxCell id="D" value="&lt;b&gt;3. Accept on a win&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;(the Select step)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;wins &amp;gt; losses?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEEEA;strokeColor=#E64B35;strokeWidth=1.6;dashed=1;fontColor=#C0392B;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="828" y="194" width="220" height="104" as="geometry"/></mxCell>

        <mxCell id="ss" value="&lt;b&gt;Self-supervised.&lt;/b&gt;  The only signal is which output wins the pairwise comparison, never a score against a labeled answer key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="324" width="400" height="54" as="geometry"/></mxCell>

        <mxCell id="eCur" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inCur" target="S1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSamp" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="inSamp" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="candidate prompt" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="wins / losses" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S2" target="D"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ess" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.3;html=1;rounded=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ss" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="efb" value="next round: on a win current = candidate, otherwise keep the current best, then repeat" style="endArrow=block;strokeColor=#00A087;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#1F3D35;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="D" target="S1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="938" y="430"/><mxPoint x="180" y="430"/></Array></mxGeometry></mxCell>

        <mxCell id="foot" value="Because the signal is a comparison and not a labeled answer, SPO needs no answer key and as few as three samples per round. It keeps climbing while some candidate can win and then plateaus, which is the cheapest rung on the cost-and-reach map in figure 2.7." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="1000" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
