<mxfile host="app.diagrams.net" type="device">
  <diagram name="signal-measure-concept" id="signal-measure-concept">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Measuring a signal: how good was that response?" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="820" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="A Signal scores the agent against what good looks like and returns one GapMeasurement; the method is a pluggable slot, and the LLM-as-judge is just one fit" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1000" height="18" as="geometry"/></mxCell>

        <mxCell id="bc1" value="Act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="706" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc2" value="Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;fontSize=10;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="778" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc3" value="Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bc4" value="Apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="922" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="bce1" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc1" target="bc2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bce2" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc2" target="bc3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bce3" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bc3" target="bc4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bccap" value="the step introduced here" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="706" y="104" width="272" height="16" as="geometry"/></mxCell>

        <mxCell id="in1" value="&lt;b&gt;Agent output&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;what the agent actually produced for the task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="232" height="76" as="geometry"/></mxCell>
        <mxCell id="in2" value="&lt;b&gt;What good looks like&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;a gold answer, a rubric, or the current&lt;br&gt;best response to beat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="232" height="88" as="geometry"/></mxCell>

        <mxCell id="sig" value="Signal: measure the gap  (the method is a pluggable slot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=4;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="520" height="300" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;LLM-as-judge&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot;&gt;pairwise, rubric-scored&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;this chapter, built in 03_minimal_judge.py (next figure zooms in)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="196" width="468" height="50" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Programmatic metric&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;exact match, regex, numeric closeness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="254" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;Golden-set / ground truth&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;compare against labeled answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="302" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;Human or implicit feedback&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;thumbs, edits, downstream outcomes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=8;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="326" y="350" width="468" height="40" as="geometry"/></mxCell>
        <mxCell id="sigcap" value="Swap the method; the measurement shape on the right does not change." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#3A6B5E;" vertex="1" parent="1"><mxGeometry x="326" y="404" width="468" height="30" as="geometry"/></mxCell>

        <mxCell id="gm" value="&lt;b&gt;GapMeasurement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;one shape, every method&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9B4434&quot;&gt;score &#8712; [0, 1]&lt;br&gt;preference &#8712; {LEFT, RIGHT, TIE}&lt;br&gt;feedback: one sentence&lt;br&gt;confidence &#8712; [0, 1]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="858" y="176" width="252" height="200" as="geometry"/></mxCell>
        <mxCell id="gmcap" value="Search reads this to decide whether a candidate beat the reference, and the archive stores it as the artifact's score." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7A2A1C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="858" y="386" width="252" height="64" as="geometry"/></mxCell>

        <mxCell id="ein1" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="in1" target="sig"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ein2" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.62;" edge="1" parent="1" source="in2" target="sig"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eemit" value="emit measurement" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="sig" target="gm"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="foot" value="This chapter implements the LLM-as-judge method (pairwise, with swap-and-agree to cancel position bias); the next figure opens up that box. The other methods are interchangeable: each plugs into the same slot and returns the same GapMeasurement, so the rest of the loop never has to know which one ran." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="1080" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
