<mxfile host="app.diagrams.net" type="device">
  <diagram name="search-cost-reach" id="search-cost-reach">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Choosing a search method: cost versus reach" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="820" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="Every method proposes and selects; what differs is how much it spends and how hard a search it can win. This is the ladder you climb across the book, and chapter 2 starts on the cheapest rung." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1000" height="18" as="geometry"/></mxCell>

        <mxCell id="yaxis" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="470" as="sourcePoint"/><mxPoint x="140" y="96" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="xaxis" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="470" as="sourcePoint"/><mxPoint x="930" y="470" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="ylab" value="Reach &#8594;" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="52" y="220" width="20" height="150" as="geometry"/></mxCell>
        <mxCell id="ylabsub" value="how high it can climb, and how deceptive a landscape it can still escape" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="76" y="170" width="16" height="260" as="geometry"/></mxCell>
        <mxCell id="xlab" value="Cost &#8594;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="460" y="486" width="160" height="20" as="geometry"/></mxCell>
        <mxCell id="xlabsub" value="compute and model calls spent per run" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="420" y="508" width="240" height="16" as="geometry"/></mxCell>

        <mxCell id="yhigh" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="92" y="92" width="44" height="16" as="geometry"/></mxCell>
        <mxCell id="ylow" value="low" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="92" y="456" width="44" height="16" as="geometry"/></mxCell>
        <mxCell id="xlow" value="low" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="146" y="474" width="40" height="16" as="geometry"/></mxCell>
        <mxCell id="xhigh" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="888" y="474" width="44" height="16" as="geometry"/></mxCell>

        <mxCell id="frontier" value="more cost buys more reach" style="endArrow=none;dashed=1;dashPattern=8 6;strokeColor=#B8B6AE;strokeWidth=1.4;html=1;rounded=1;fontSize=10;fontStyle=2;fontColor=#A09E96;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="312" as="sourcePoint"/><mxPoint x="812" y="132" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p_rand" value="&lt;b&gt;Random / blind&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#5F5E5A&quot;&gt;unguided&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F3EF;strokeColor=#B8B6AE;strokeWidth=1;fontColor=#5F5E5A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="402" width="118" height="40" as="geometry"/></mxCell>
        <mxCell id="p_spo" value="&lt;b&gt;SPO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;mutate, score, accept&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.8;fontColor=#1F3D35;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="p_gepa" value="&lt;b&gt;GEPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;reflect, evolve a population&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="538" y="168" width="156" height="46" as="geometry"/></mxCell>
        <mxCell id="p_dgm" value="&lt;b&gt;DGM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;archive of diverse variants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="744" y="103" width="156" height="46" as="geometry"/></mxCell>

        <mxCell id="t_spo" value="this chapter: the cheapest method that works; plateaus on a hard landscape" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#3A6B5E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="330" width="290" height="30" as="geometry"/></mxCell>
        <mxCell id="t_later" value="+ later chapters" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B8B6AE;" vertex="1" parent="1"><mxGeometry x="760" y="158" width="150" height="16" as="geometry"/></mxCell>

        <mxCell id="foot" value="The gap only appears when the search is hard. On an easy landscape these methods converge, so the extra cost buys nothing; the difference is demonstrated in chapter 3." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="384" width="450" height="40" as="geometry"/></mxCell>

        <mxCell id="rule" value="&lt;b&gt;Rule of thumb&lt;/b&gt;&amp;nbsp;&amp;nbsp;Use the cheapest search that can still reach the solution your landscape hides." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="522" width="620" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
