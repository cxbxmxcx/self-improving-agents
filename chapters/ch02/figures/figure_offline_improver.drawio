<mxfile host="app.diagrams.net" type="device">
  <diagram name="offline-improver" id="offline-improver">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="The OfflineImprover: the self-improvement loop, run offline" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="860" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="Each loop stage is one of the components you passed in; the whole loop runs against the eval set and only writes to the archive, while the live agent keeps serving the champion until a human promotes a winner" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1070" height="18" as="geometry"/></mxCell>

        <mxCell id="offbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;strokeWidth=1.6;dashed=1;dashPattern=8 5;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="980" height="196" as="geometry"/></mxCell>
        <mxCell id="offbadge" value="OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="54" y="92" width="86" height="22" as="geometry"/></mxCell>
        <mxCell id="offlbl" value="the improvement loop runs here, against the eval set, never on live traffic" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="150" y="92" width="520" height="22" as="geometry"/></mxCell>

        <mxCell id="S1" value="&lt;b&gt;Propose&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;(Search: SPO)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;mutate the current best prompt&lt;br&gt;into a candidate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="270" height="86" as="geometry"/></mxCell>
        <mxCell id="S2" value="&lt;b&gt;Measure&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;(Signal + Agent + EvalSource)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;the agent (cloned per candidate) answers the eval questions under both prompts; the swap-and-agree judge scores candidate vs current best on the rubric&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="350" height="86" as="geometry"/></mxCell>
        <mxCell id="S3" value="&lt;b&gt;Record&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;(Archive)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;write the candidate and its score; no promotion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.6;fontColor=#7A2A1C;arcSize=8;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="750" y="130" width="240" height="86" as="geometry"/></mxCell>

        <mxCell id="e12" value="candidate" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="score" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="erepeat" value="repeat each round  (Policy decides when and how many questions)" style="endArrow=block;strokeColor=#00A087;strokeWidth=1.8;fontSize=10;fontStyle=1;fontColor=#1F3D35;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="S3" target="S1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="104"/><mxPoint x="205" y="104"/></Array></mxGeometry></mxCell>

        <mxCell id="archive" value="SQLiteArchive&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;every version + score&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FBE9E4;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="160" height="170" as="geometry"/></mxCell>
        <mxCell id="ewrite" value="candidate + score" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.4;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="S3" target="archive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eseed" value="read current best (seed)" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.2;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="archive" target="S1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="livebadge" value="LIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3C5488;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="338" width="64" height="22" as="geometry"/></mxCell>
        <mxCell id="liveagent" value="&lt;b&gt;Live agent&lt;/b&gt; (production)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#3A4A66&quot;&gt;serves the live champion&lt;br&gt;on every request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8ECF3;strokeColor=#3C5488;strokeWidth=1.6;fontColor=#27324A;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="368" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="promote" value="&lt;b&gt;promote()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;human deploy gate&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEEEA;strokeColor=#E64B35;strokeWidth=1.6;dashed=1;fontColor=#C0392B;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="636" y="380" width="130" height="76" as="geometry"/></mxCell>
        <mxCell id="epromo" value="a human ships a winner" style="endArrow=block;strokeColor=#E64B35;strokeWidth=1.5;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="archive" target="promote"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eserve" value="sets the champion" style="endArrow=block;strokeColor=#3C5488;strokeWidth=1.6;fontSize=10;fontColor=#3C5488;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="promote" target="liveagent"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="callout" value="&lt;b&gt;The loop never touches the live agent.&lt;/b&gt;  It reads the current best, proposes and scores candidates, and writes them to the archive, all offline. What production serves changes only when a human opens the promote() gate; a winning candidate waits in the archive until then." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#1F3D35;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="560" height="68" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
