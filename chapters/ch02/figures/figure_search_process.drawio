<mxfile host="app.diagrams.net" type="device">
  <diagram name="search-process" id="search-process">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Search: the self-improvement loop, run to find the best candidate" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="860" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="One pass proposes a variant of the artifact, measures it with the signal, and keeps the best; search is that pass run again and again until the candidate stops improving" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1060" height="18" as="geometry"/></mxCell>

        <mxCell id="inCur" value="&lt;b&gt;Current best artifact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;carried across rounds (genesis on round 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.4;fontColor=#7A2A1C;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="84" width="240" height="56" as="geometry"/></mxCell>

        <mxCell id="S1" value="&lt;b&gt;Propose&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F3D35&quot;&gt;generate a new variant of&lt;br&gt;the current best&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;the method is pluggable: SPO here;&lt;br&gt;GEPA, DGM in chapter 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="184" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="S2" value="&lt;b&gt;Measure&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot; color=&quot;#3A6B5E&quot;&gt;(the Signal)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F3D35&quot;&gt;score the new variant&lt;br&gt;against the current best&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="360" y="184" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="S3" value="&lt;b&gt;Select&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F3D35&quot;&gt;apply the verdict: keep the&lt;br&gt;variant if the signal preferred it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="660" y="184" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="best" value="&lt;b&gt;Best candidate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#7A2A1C&quot;&gt;the new artifact, after the rounds run out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.8;fontColor=#7A2A1C;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="952" y="206" width="150" height="80" as="geometry"/></mxCell>

        <mxCell id="eCur" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inCur" target="S1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCur2" value="vs current best" style="endArrow=block;dashed=1;dashPattern=6 4;strokeColor=#888780;strokeWidth=1.2;fontSize=10;fontStyle=2;fontColor=#888780;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0.18;entryY=0;" edge="1" parent="1" source="inCur" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="new variant" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="verdict" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.5;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ebest" value="after N rounds" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#888780;strokeWidth=1.4;fontSize=10;fontStyle=2;fontColor=#888780;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="S3" target="best"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eloop" value="repeat each round" style="endArrow=block;strokeColor=#00A087;strokeWidth=1.8;fontSize=11;fontStyle=1;fontColor=#1F3D35;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="S3" target="S1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="406"/><mxPoint x="180" y="406"/></Array></mxGeometry></mxCell>

        <mxCell id="callout" value="&lt;b&gt;Search is the self-improvement loop, iterated.&lt;/b&gt;  Measuring with the signal and keeping the winner stay the same for every method; the only part a method changes is how it proposes, which is the pluggable slot from figure 2.6. Running the loop many times is how search climbs toward the best candidate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#1F3D35;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="1042" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
