<mxfile host="app.diagrams.net" type="device">
  <diagram name="offline-loop-archive" id="offline-archive">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="490" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="The offline improvement loop, through the archive" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="640" height="26" as="geometry"/></mxCell>
        <mxCell id="n3" value="The prompt is an Artifact in a persistent archive; the agent serves the live champion, and only promote() changes it" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="820" height="20" as="geometry"/></mxCell>
        <mxCell id="n4" value="" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2C2C2A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="80" height="58" as="geometry"/></mxCell>
        <mxCell id="n5" value="" style="ellipse;fillColor=#2C2C2A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="59" y="129" width="11" height="11" as="geometry"/></mxCell>
        <mxCell id="n6" value="" style="ellipse;fillColor=#2C2C2A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="90" y="129" width="11" height="11" as="geometry"/></mxCell>
        <mxCell id="n7" value="" style="rounded=1;arcSize=60;fillColor=none;strokeColor=#2C2C2A;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="67" y="148" width="22" height="5" as="geometry"/></mxCell>
        <mxCell id="n8" value="" style="rounded=1;arcSize=40;fillColor=#2C2C2A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="31" y="124" width="9" height="20" as="geometry"/></mxCell>
        <mxCell id="n9" value="" style="rounded=1;arcSize=40;fillColor=#2C2C2A;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="120" y="124" width="9" height="20" as="geometry"/></mxCell>
        <mxCell id="n10" value="the agent runs the task" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="20" y="172" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Act&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F5E5A&quot;&gt;answers using the live-champion prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;Signal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3A6B5E&quot;&gt;judge scores the response&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3A6B5E&quot;&gt;SPO proposes prompt variants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F5E5A&quot;&gt;promote() the winning variant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="240" height="72" as="geometry"/></mxCell>
        <mxCell id="n15" value="Artifact archive&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;SQLite: every prompt version + its score&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FBE9E4;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;fontSize=12;boundedLbl=1;backgroundOutline=1;size=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="430" y="198" width="120" height="128" as="geometry"/></mxCell>
        <mxCell id="n16" value="" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n18" value="" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n20" value="promote()&lt;br&gt;deploy gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#E64B35;strokeWidth=1.5;dashed=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E64B35;arcSize=10;" vertex="1" parent="1"><mxGeometry x="250" y="238" width="100" height="36" as="geometry"/></mxCell>
        <mxCell id="n21" value="repeat" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="250" y="196" width="100" height="18" as="geometry"/></mxCell>
        <mxCell id="n22" value="serve live champion" style="endArrow=open;endFill=1;endSize=8;html=1;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;rounded=1;exitX=0;exitY=0.35;entryX=0.78;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="put candidate + score" style="endArrow=open;endFill=1;endSize=8;html=1;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;rounded=1;exitX=0;exitY=0.5;entryX=1;entryY=0.62;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n24" value="promote winner" style="endArrow=open;endFill=1;endSize=8;html=1;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.62;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="Act never edits the prompt. It reads whatever is currently promoted; on first run that is the genesis seed, stored with no score until a Signal measures it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5F5E5A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="14" y="250" width="156" height="96" as="geometry"/></mxCell>
        <mxCell id="n26" value="" style="endArrow=block;startArrow=none;html=1;dashed=1;strokeColor=#888780;strokeWidth=1;rounded=1;" edge="1" parent="1" source="n25" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="best() ranks every candidate by score, but the agent does not serve a winner until promote() is called." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5F5E5A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="n28" value="" style="endArrow=block;startArrow=none;html=1;dashed=1;strokeColor=#888780;strokeWidth=1;rounded=1;" edge="1" parent="1" source="n27" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="A higher-scoring candidate can sit in the archive unpromoted. Improvement is delivered by promoting a new Artifact, not by changing the agent loop." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#C0392B;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="196" height="96" as="geometry"/></mxCell>
        <mxCell id="n30" value="" style="endArrow=block;startArrow=none;html=1;dashed=1;strokeColor=#888780;strokeWidth=1;rounded=1;" edge="1" parent="1" source="n29" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="Artifact range: prompt, memory, reasoning scaffold, or code. Here the Artifact is the system-instruction prompt." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="560" height="24" as="geometry"/></mxCell>
      </root>
