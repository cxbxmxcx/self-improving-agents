<mxfile host="app.diagrams.net" type="device">
  <diagram name="offline-helix-overview" id="offline-helix-overview">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Putting it together with Helix" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="620" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="You compose the parts into one OfflineImprover that runs offline and writes to a persistent archive; the live agent keeps serving the champion until a human promotes a winner across the gate" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1070" height="18" as="geometry"/></mxCell>

        <mxCell id="offbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888780;strokeWidth=1.6;dashed=1;dashPattern=8 5;arcSize=3;" vertex="1" parent="1"><mxGeometry x="36" y="78" width="700" height="312" as="geometry"/></mxCell>
        <mxCell id="offbadge" value="OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="86" width="86" height="22" as="geometry"/></mxCell>
        <mxCell id="offlbl" value="you assemble and run this; it never touches live traffic" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="144" y="86" width="380" height="22" as="geometry"/></mxCell>

        <mxCell id="lbl" value="Parts you instantiate" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="52" y="116" width="240" height="14" as="geometry"/></mxCell>
        <mxCell id="pAgent" value="&lt;b&gt;Agent&lt;/b&gt;  &lt;font style=&quot;font-size:9px&quot; color=&quot;#5F5E5A&quot;&gt;the definition under improvement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52" y="134" width="234" height="42" as="geometry"/></mxCell>
        <mxCell id="pSignal" value="&lt;b&gt;Signal&lt;/b&gt; = SwapAndAgree(PairwiseJudge)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#3A6B5E&quot;&gt;the judge from section 2.2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.3;fontColor=#1F3D35;arcSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52" y="182" width="234" height="42" as="geometry"/></mxCell>
        <mxCell id="pSearch" value="&lt;b&gt;Search&lt;/b&gt; = SPO&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#3A6B5E&quot;&gt;the search from section 2.3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.3;fontColor=#1F3D35;arcSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52" y="230" width="234" height="42" as="geometry"/></mxCell>
        <mxCell id="pEval" value="&lt;b&gt;EvalSource&lt;/b&gt; = FixedEvalSet&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#5F5E5A&quot;&gt;the questions, no reference answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52" y="278" width="234" height="42" as="geometry"/></mxCell>
        <mxCell id="pPolicy" value="&lt;b&gt;Policy&lt;/b&gt; = ImproverPolicy&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#5F5E5A&quot;&gt;when rounds run, how winners promote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52" y="326" width="234" height="42" as="geometry"/></mxCell>

        <mxCell id="improver" value="&lt;b&gt;OfflineImprover&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F5E5A&quot;&gt;composes the parts and&lt;br&gt;runs the loop one round&lt;br&gt;at a time&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#888780&quot;&gt;(zoomed in, figure 2.11)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#2C2C2A;strokeWidth=2;fontColor=#2C2C2A;arcSize=6;align=center;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="380" height="220" as="geometry"/></mxCell>

        <mxCell id="ea" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.1;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.18;" edge="1" parent="1" source="pAgent" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es" style="endArrow=block;strokeColor=#00A087;strokeWidth=1.1;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.37;" edge="1" parent="1" source="pSignal" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="esr" style="endArrow=block;strokeColor=#00A087;strokeWidth=1.1;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.55;" edge="1" parent="1" source="pSearch" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.1;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.73;" edge="1" parent="1" source="pEval" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ep" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.1;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="pPolicy" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="archive" value="SQLiteArchive&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;every prompt version&lt;br&gt;+ its score&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FBE9E4;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;fontSize=12;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="788" y="150" width="150" height="170" as="geometry"/></mxCell>
        <mxCell id="ewrite" value="writes candidate + score" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.36;entryX=0;entryY=0.4;" edge="1" parent="1" source="improver" target="archive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eread" value="reads the seed / best" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0;exitY=0.72;entryX=1;entryY=0.66;" edge="1" parent="1" source="archive" target="improver"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="livebox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3C5488;strokeWidth=1.6;dashed=1;dashPattern=8 5;arcSize=4;" vertex="1" parent="1"><mxGeometry x="772" y="398" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="livebadge" value="LIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3C5488;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;arcSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="784" y="406" width="60" height="22" as="geometry"/></mxCell>
        <mxCell id="liveagent" value="&lt;b&gt;Live agent&lt;/b&gt; (production)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#3A4A66&quot;&gt;serves the live champion&lt;br&gt;on every request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8ECF3;strokeColor=#3C5488;strokeWidth=1.6;fontColor=#27324A;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="438" width="264" height="96" as="geometry"/></mxCell>

        <mxCell id="promote" value="&lt;b&gt;promote()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;human deploy gate&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEEEA;strokeColor=#E64B35;strokeWidth=1.6;dashed=1;fontColor=#C0392B;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="338" width="138" height="62" as="geometry"/></mxCell>
        <mxCell id="epromo" value="a human ships a winner" style="endArrow=block;strokeColor=#E64B35;strokeWidth=1.5;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="archive" target="promote"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eserve" value="sets the champion" style="endArrow=block;strokeColor=#3C5488;strokeWidth=1.6;fontSize=10;fontColor=#3C5488;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="promote" target="liveagent"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="callout" value="&lt;b&gt;Offline on the left, live on the right.&lt;/b&gt;  You compose the parts, and the improver runs the loop and writes candidates to the archive, all offline. The live agent keeps serving the champion; only promote(), a deliberate human gate, moves a winner from the archive into production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#1F3D35;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="410" width="700" height="74" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
