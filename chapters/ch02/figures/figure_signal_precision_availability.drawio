<mxfile host="app.diagrams.net" type="device">
  <diagram name="signal-precision-availability" id="signal-precision-availability">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Choosing a signal: precision versus availability" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="820" height="26" as="geometry"/></mxCell>
        <mxCell id="h2" value="Every method measures the same gap; what differs is how accurately it reports it and how readily you can get it. You want the most precise signal you can actually get." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="980" height="18" as="geometry"/></mxCell>

        <mxCell id="yaxis" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="470" as="sourcePoint"/><mxPoint x="140" y="96" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="xaxis" style="endArrow=block;html=1;strokeColor=#5F5E5A;strokeWidth=1.5;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="470" as="sourcePoint"/><mxPoint x="930" y="470" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="ylab" value="Precision &#8594;" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="52" y="220" width="20" height="150" as="geometry"/></mxCell>
        <mxCell id="ylabsub" value="how accurately it reports the gap (same verdict twice; tracks real quality, not length or tone)" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="76" y="150" width="16" height="300" as="geometry"/></mxCell>
        <mxCell id="xlab" value="Availability &#8594;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="430" y="486" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="xlabsub" value="how cheaply and quickly you can get it, without special infrastructure or paid human labor" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="330" y="508" width="420" height="16" as="geometry"/></mxCell>

        <mxCell id="yhigh" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="92" y="92" width="44" height="16" as="geometry"/></mxCell>
        <mxCell id="ylow" value="low" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="92" y="456" width="44" height="16" as="geometry"/></mxCell>
        <mxCell id="xlow" value="low" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="146" y="474" width="40" height="16" as="geometry"/></mxCell>
        <mxCell id="xhigh" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="888" y="474" width="44" height="16" as="geometry"/></mxCell>

        <mxCell id="trend" value="the two rarely move together" style="endArrow=none;dashed=1;dashPattern=8 6;strokeColor=#B8B6AE;strokeWidth=1.4;html=1;rounded=1;fontSize=10;fontStyle=2;fontColor=#A09E96;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="150" as="sourcePoint"/><mxPoint x="720" y="290" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="p_human" value="&lt;b&gt;Human evaluator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;a person reads and judges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="153" y="155" width="156" height="46" as="geometry"/></mxCell>
        <mxCell id="p_gold" value="&lt;b&gt;Gold set&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;fixed questions + known answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="103" width="156" height="46" as="geometry"/></mxCell>
        <mxCell id="p_prog" value="&lt;b&gt;Programmatic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;deterministic pass / fail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1.2;fontColor=#2C2C2A;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="99" width="156" height="46" as="geometry"/></mxCell>
        <mxCell id="p_judge" value="&lt;b&gt;LLM-as-Judge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F3D35&quot;&gt;a model rates against a rubric&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.8;fontColor=#1F3D35;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="716" y="279" width="156" height="46" as="geometry"/></mxCell>

        <mxCell id="t_precise" value="precise, but slow and costly to produce" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="153" y="206" width="300" height="16" as="geometry"/></mxCell>
        <mxCell id="t_judge" value="this chapter: available everywhere (just another model call), but less precise" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#3A6B5E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="320" height="30" as="geometry"/></mxCell>
        <mxCell id="t_prog" value="deterministic and cheap, but only when the output reduces to a clean check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="t_prog_edge" style="endArrow=block;html=1;dashed=1;strokeColor=#E64B35;strokeWidth=1.1;rounded=1;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="t_prog" target="p_prog"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="rule" value="&lt;b&gt;Rule of thumb&lt;/b&gt;&amp;nbsp;&amp;nbsp;You are not hunting for the single best signal. You are hunting for the most precise one you can actually get for the task in front of you." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=8;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="520" width="620" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
