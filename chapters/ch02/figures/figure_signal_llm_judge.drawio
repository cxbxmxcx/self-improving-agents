<mxfile host="app.diagrams.net" type="device">
  <diagram name="signal-llm-judge" id="signal-judge">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Inside the Signal step: an LLM-as-judge measures the agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="650" height="26" as="geometry"/></mxCell>
        <mxCell id="n3" value="Each gold-set item is scored against a rubric; running the judge both ways and requiring agreement removes position bias" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="660" height="18" as="geometry"/></mxCell>
        <mxCell id="n4" value="Act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="706" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="n5" value="Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CDE9E3;strokeColor=#00A087;strokeWidth=1.6;fontColor=#1F3D35;fontSize=10;fontStyle=1;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="778" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="n6" value="Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="n7" value="Apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#5F5E5A;fontSize=10;arcSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="922" y="78" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="n8" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n10" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="the step expanded below" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="706" y="104" width="272" height="16" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;Gold-set item&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;question + reference (gold) answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="224" height="60" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;Two answers to compare&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;LEFT = answer A, RIGHT = answer B,&lt;br&gt;each produced under a different prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#888780;strokeWidth=1;fontColor=#2C2C2A;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="224" height="84" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Rubric&lt;/b&gt;  &lt;font style=&quot;font-size:10px&quot;&gt;(judge system prompt)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;1. factual accuracy vs reference&lt;br&gt;2. grounded in sources, not invented&lt;br&gt;3. clarity and directness&lt;br&gt;&lt;br&gt;reply JSON: winner + feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=1.5;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="334" width="224" height="150" as="geometry"/></mxCell>
        <mxCell id="n15" value="LLM-as-judge  (claude-sonnet-4-6, judge_once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=4;align=center;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="128" width="520" height="408" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Run 1: forward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;LEFT = A, RIGHT = B&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;&amp;#8594; winner_fwd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F1EC;strokeColor=#00A087;strokeWidth=1.2;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="326" y="196" width="212" height="84" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;Run 2: reverse (swap)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;LEFT = B, RIGHT = A&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;&amp;#8594; remap(winner_rev)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F1EC;strokeColor=#00A087;strokeWidth=1.2;fontColor=#1F3D35;arcSize=8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="582" y="196" width="212" height="84" as="geometry"/></mxCell>
        <mxCell id="n18" value="Swap the order, and a position-biased judge flips its pick." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="326" y="286" width="468" height="20" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;swap and agree&lt;/b&gt;&lt;br&gt;winner_fwd ==&lt;br&gt;remap(winner_rev)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCEEEA;strokeColor=#E64B35;strokeWidth=1.5;dashed=1;fontColor=#C0392B;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="314" width="180" height="84" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;winner&lt;/b&gt;: LEFT or RIGHT&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;agreed = True&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEBE6;strokeColor=#00A087;strokeWidth=1.5;fontColor=#2C2C2A;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="322" y="432" width="182" height="58" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;TIE&lt;/b&gt;, agreed = False&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F5E5A&quot;&gt;judge disagreed across the swap;&lt;br&gt;trust neither run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEEEA;strokeColor=#E64B35;strokeWidth=1.5;dashed=1;fontColor=#C0392B;arcSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="596" y="432" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="n22" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.18;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.34;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n24" value="system prompt" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.4;entryX=0;entryY=0.72;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=0.6;exitY=1;entryX=0.2;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n26" value="" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;html=1;rounded=1;exitX=0.4;exitY=1;entryX=0.8;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="agree" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.15;exitY=1;entryX=0.7;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n28" value="disagree" style="endArrow=block;strokeColor=#5F5E5A;strokeWidth=1.3;fontSize=10;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.85;exitY=1;entryX=0.3;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Measured signal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9B4434&quot;&gt;winner &amp;#8712; {LEFT, RIGHT, TIE}&lt;br&gt;agreed flag&lt;br&gt;one-sentence feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE7E2;strokeColor=#E64B35;strokeWidth=2;fontColor=#7A2A1C;arcSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="878" y="210" width="224" height="110" as="geometry"/></mxCell>
        <mxCell id="n30" value="emit verdict" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="This verdict is the signal. It tells Search and Apply whether a candidate prompt beat the reference, and it is the score stored against the artifact in the archive." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7A2A1C;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="878" y="338" width="224" height="110" as="geometry"/></mxCell>
        <mxCell id="n32" value="" style="endArrow=open;endFill=1;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#E64B35;strokeWidth=1.6;fontSize=10;fontStyle=2;fontColor=#C0392B;labelBackgroundColor=#FFFFFF;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="In the shipped demo the question is the 2017 Attention paper: LEFT gives a grounded Transformer answer, RIGHT hallucinates BERT. A consistent judge picks LEFT in both orders; a position-biased one flips, and swap-and-agree returns TIE." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#888780;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="502" width="770" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>