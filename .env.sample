# HelixAgent — environment variables
#
# Copy this file to .env and fill in the keys for whichever LLM providers
# you intend to use. .env is gitignored. .env.sample is committed as the
# canonical reference of what variables exist.
#
# LiteLLM picks up provider keys by their canonical names; do not rename.

# ----- LLM providers ------------------------------------------------------

# Anthropic (Claude). Used by default in chapters/ch02/.
ANTHROPIC_API_KEY=""

# OpenAI (GPT). Uncomment if you switch chapter scripts to gpt-4o-mini etc.
# OPENAI_API_KEY=""

# Google (Gemini). Either name works for LiteLLM.
# GOOGLE_API_KEY=""
# GEMINI_API_KEY=""

# Other providers LiteLLM supports out of the box (uncomment as needed):
# COHERE_API_KEY=""
# GROQ_API_KEY=""
# MISTRAL_API_KEY=""
# TOGETHER_API_KEY=""
# DEEPSEEK_API_KEY=""

# ----- Hugging Face -------------------------------------------------------

# Pick one of the two strategies below; either silences the "unauthenticated
# requests to the HF Hub" warning that fires every time a retrieval index
# opens.

# Option A (recommended for local dev): skip the HF Hub network check
# entirely. The embedding model is already cached locally and we don't
# need to check for upstream updates on every retrieval-index open. Set
# to 0 to re-enable the update check.
HF_HUB_OFFLINE=1

# Option B: stay online but authenticate. Get a read-only token at
# https://huggingface.co/settings/tokens and paste it here. Gives faster
# downloads on first run and removes anonymous rate limits.
# HF_TOKEN=""

# ----- Helix-specific overrides ------------------------------------------

# Optional. Override the default model used by chapter scripts.
# HELIX_MODEL="claude-haiku-4-5"
