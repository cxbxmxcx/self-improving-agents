        <mxCell id="legend-1" value="●  Each dial of the loop (signal / search / apply) is independent &#8212; you can change one without touching the others." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
