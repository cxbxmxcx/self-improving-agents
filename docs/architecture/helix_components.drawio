<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="Helix components" id="helix-components">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================================ -->
        <!-- TITLE                                        -->
        <!-- ============================================ -->
        <mxCell id="title" value="Helix &#8212; Component Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#2D3748;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Five bands top-to-bottom: surfaces, agent runtime, improver, L0 primitives, external. Five labeled flows trace the major paths." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4A5568;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1720" height="22" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- BAND 1: SURFACES (humans + external)         -->
        <!-- ============================================ -->
        <mxCell id="band1-label" value="Band 1 &#8212; Surfaces" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#718096;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1720" height="160" as="geometry" />
        </mxCell>

        <!-- Chat UI -->
        <mxCell id="chat-ui" value="Chat UI (Streamlit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="chat-ui-body" value="● Conversation surface&#10;● Reads archive.live_champion(id)&#10;● Improver panel: mode badge,&#10;   attach/pause/trigger/detach&#10;● 'Promote v{N} → live' button" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- Dashboard -->
        <mxCell id="dashboard" value="Dashboard (Streamlit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dashboard-body" value="● Overview, Champion, Lineage,&#10;   Compare, Verdicts, Replay, Rounds&#10;● Live vs best comparison&#10;● Promotion history per artifact&#10;● Per-row promote buttons" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="160" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- Agent specs -->
        <mxCell id="agent-specs" value="Agent specs (agents/&lt;name&gt;.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="agent-specs-body" value="● build() &#8594; Agent (required)&#10;● build_genesis_prompt() &#8594; Artifact&#10;● build_improvers(agent) &#8594; [Improver]&#10;● list_improvable_artifacts(agent)&#10;● Optional &#8212; agents may have none" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="360" height="100" as="geometry" />
        </mxCell>

        <!-- HITL queue -->
        <mxCell id="hitl-queue" value="HITL queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1300" y="130" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hitl-body" value="● Offline candidates pending review&#10;● Proposals (candidate, reference, score)&#10;● Human approve / reject / defer&#10;● On approve: archive.promote(approver=user)&#10;● Audit trail = promotion_history" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="160" width="410" height="100" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- BAND 2: AGENT RUNTIME (hot path)             -->
        <!-- ============================================ -->
        <mxCell id="band2-label" value="Band 2 &#8212; Agent runtime (hot path)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#718096;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1720" height="190" as="geometry" />
        </mxCell>

        <!-- Agent -->
        <mxCell id="agent" value="Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8D6;strokeColor=#F2994A;strokeWidth=3;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="agent-body" value="state:&#10;  ● system_prompt: Artifact (resolved at request start)&#10;  ● tools: list[Tool]   ● memory_tiers: dict[str, MemoryTier]&#10;  ● improvers: list[Improver]&#10;&#10;run(task, context) → (answer, Trajectory)&#10;  1. resolve = archive.live_champion(id) or genesis&#10;  2. ReAct loop with tools&#10;  3. emit Trajectory* events on bus" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="520" height="130" as="geometry" />
        </mxCell>

        <!-- Trajectory -->
        <mxCell id="trajectory" value="Trajectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8D6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="trajectory-body" value="● task, steps[], outcome, final_output&#10;● Steps: thought / tool_call / tool_result&#10;● Replayable: given trajectory + artifact&#10;   versions, the framework reconstructs&#10;   the exact input context for any step.&#10;● Cached in archive keyed by&#10;   (artifact_id, version, question_id)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="360" width="360" height="130" as="geometry" />
        </mxCell>

        <!-- Agent spec loader -->
        <mxCell id="agent-loader" value="Agent spec loader (helix.agents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8D6;strokeColor=#F2994A;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="330" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="agent-loader-body" value="● list_agents()&#10;● load_agent(name, **overrides)&#10;● load_genesis_prompt(name)&#10;● load_improvers(name, agent)&#10;● describe_agent(name) → metadata&#10;● Falls back gracefully when&#10;   build_improvers is absent." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="360" width="330" height="130" as="geometry" />
        </mxCell>

        <!-- Memory tiers cluster (right side of band 2) -->
        <mxCell id="memory-cluster" value="Memory tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7EC;strokeColor=#27AE60;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1440" y="330" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="mem-working" value="Working&#10;(per-turn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontColor=#2D3748;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1450" y="360" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mem-episodic" value="Episodic&#10;(recall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontColor=#2D3748;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1590" y="360" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mem-semantic" value="Semantic&#10;(facts, prefs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontColor=#2D3748;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1450" y="420" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mem-procedural" value="Procedural&#10;(skills)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontColor=#2D3748;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1590" y="420" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- BAND 3: IMPROVER (cold path)                 -->
        <!-- ============================================ -->
        <mxCell id="band3-label" value="Band 3 &#8212; Improver (cold path) &#8212; the loop&#39;s engine" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#718096;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1720" height="270" as="geometry" />
        </mxCell>

        <!-- Improver composite -->
        <mxCell id="improver" value="Improver (long-running, per-artifact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFC;strokeColor=#9B51E0;strokeWidth=3;fontColor=#2D3748;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="780" height="230" as="geometry" />
        </mxCell>
        <mxCell id="improver-fields" value="target_artifact_id: str&#10;Signal &#8212; how to measure the gap&#10;Search &#8212; how to find a better variant&#10;Archive &#8212; durable storage&#10;EvalSource &#8212; questions to test against&#10;Policy:&#10;  ● schedule: MANUAL | INTERVAL | CONTINUOUS&#10;  ● mode: OFFLINE | ONLINE&#10;  ● auto_promote: bool (default True)&#10;  ● promote_threshold_win_rate, budget, concurrency caps" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="590" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="improver-flow" value="Round flow:&#10;  1. EvalSource.get_questions()&#10;  2. Search.propose() → candidate Artifact&#10;  3. archive.record(candidate, measurement)&#10;  4. Signal judges candidate vs current best&#10;  5. archive.record(reference, measurement)&#10;  6. if candidate beat reference:&#10;       emit CandidateWins(mode, auto_promote)&#10;  7. emit ImproverRoundCompleted&#10;&#10;Safety check at construction:&#10;  mode==ONLINE + layer&gt;=3 → ValueError" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=12;fontFamily=Consolas,Courier New,monospace;" vertex="1" parent="1">
          <mxGeometry x="480" y="585" width="370" height="200" as="geometry" />
        </mxCell>

        <!-- Background runner -->
        <mxCell id="bg-runner" value="Background runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EBFC;strokeColor=#9B51E0;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="560" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bg-runner-body" value="● Daemon thread with own&#10;   asyncio event loop&#10;● Streamlit-compatible&#10;● attach/start/pause/resume&#10;● Process-wide registry by id" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2D3748;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="590" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Promotion hook -->
        <mxCell id="promo-hook" value="Promotion hook (helix.improvement.promotion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#F2C94C;strokeWidth=3;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="560" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="promo-hook-body" value="Single global handler subscribed to candidate_wins.&#10;&#10;Decision:&#10;  if event.mode != &quot;online&quot;: return        # await human&#10;  if not event.auto_promote:  return        # custom policy&#10;  archive.promote(&#10;      artifact_id, candidate_version,&#10;      approver=f&quot;improver:{event.improver_id}&quot;,&#10;      reason=round_summary&#10;  )&#10;&#10;archive.promote() emits Promoted on the bus &#8212;&#10;dashboards, audit logs, the chat UI all subscribe.&#10;&#10;Override: policy.auto_promote=False + your own handler.&#10;(confidence thresholds, Pareto dominance, two-judge agree)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=12;fontFamily=Consolas,Courier New,monospace;" vertex="1" parent="1">
          <mxGeometry x="1210" y="590" width="520" height="195" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- BAND 4: L0 TOOLKIT PRIMITIVES                -->
        <!-- ============================================ -->
        <mxCell id="band4-label" value="Band 4 &#8212; L0 toolkit primitives" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#718096;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1720" height="330" as="geometry" />
        </mxCell>

        <!-- Artifact -->
        <mxCell id="prim-artifact" value="Artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B51E0;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="870" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-artifact-body" value="Immutable, versioned, content-addressed.&#10;&#10;● id, version, kind, content&#10;● parent_id, created_by&#10;● mutate() &#8594; new version&#10;● kind.layer &#8594; 1|2|3|4&#10;   (gates ONLINE mode)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="900" width="240" height="115" as="geometry" />
        </mxCell>

        <!-- Archive -->
        <mxCell id="prim-archive" value="Archive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B51E0;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="870" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-archive-body" value="Durable store: artifacts, measurements,&#10;variants, promotions, trajectories.&#10;&#10;● record(variant, measurement)&#10;● best(k), pareto_front(objectives)&#10;● live_champion(id) ← deployment&#10;● promote(id, ver, approver, reason)&#10;● promotion_history(id)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="900" width="270" height="115" as="geometry" />
        </mxCell>

        <!-- Signal -->
        <mxCell id="prim-signal" value="Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="660" y="870" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-signal-body" value="Returns GapMeasurement (score / preference&#10;/ feedback / confidence / cost).&#10;&#10;Families:&#10;  ● Ground-truth / environment (precise)&#10;  ● Judge (LLM-as-Judge, pairwise, contrastive)&#10;  ● Process / reflection (PRM, self-critique)&#10;Wrappers: SwapAndAgree, Composite" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="900" width="270" height="115" as="geometry" />
        </mxCell>

        <!-- Search -->
        <mxCell id="prim-search" value="Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9B51E0;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="970" y="870" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-search-body" value="propose() / select() over artifacts.&#10;&#10;Families:&#10;  ● Hill-climb (cheapest, single thread)&#10;  ● Pairwise / population (SPO, GEPA, MIPRO)&#10;  ● Reinforcement (MemRL, GRPO)&#10;  ● Evolutionary archive (DGM, AlphaEvolve)&#10;  ● Meta-search (HyperAgents)&#10;Composer: StrategyChain (failure budget)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="900" width="270" height="115" as="geometry" />
        </mxCell>

        <!-- Eval -->
        <mxCell id="prim-eval" value="Eval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1280" y="870" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-eval-body" value="EvalSource &#8594; questions.&#10;&#10;● FixedEvalSet (curated)&#10;● RecentTrajectorySource&#10;   (live traffic buffer)&#10;● GoldenSet (calibration)&#10;● Composite (anchored)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="900" width="200" height="115" as="geometry" />
        </mxCell>

        <!-- Hook -->
        <mxCell id="prim-hook" value="Hook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2C94C;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1520" y="870" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="prim-hook-body" value="Canonical fire points:&#10;&#10;● PreAgentRun / PostAgentRun&#10;● PreToolUse / PostToolUse&#10;● PreSignalMeasure / Post&#10;● PreSearchProposal / Post&#10;● OnCandidateWins&#10;● OnPromoted" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1530" y="900" width="200" height="115" as="geometry" />
        </mxCell>

        <!-- Bus -->
        <mxCell id="prim-bus" value="Observability Bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F2C94C;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1040" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="prim-bus-body" value="Typed EventBus (in-process) + OTel wire format.&#10;&#10;Events: ArtifactCreated, ArtifactMeasured, MutationProposed,&#10;SearchStarted/Completed, ImproverRoundStarted/Completed,&#10;CandidateWins, Promoted, TrajectoryStarted/Step/Completed,&#10;HookFired, RateLimitWaited, BudgetExceeded, DriftDetected." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="1070" width="410" height="95" as="geometry" />
        </mxCell>

        <!-- Trajectory primitive (already shown above; reference here) -->
        <mxCell id="prim-trajectory" value="Trajectory (see Band 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;strokeWidth=1;fontColor=#4A5568;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="1040" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Memory primitive (already shown above) -->
        <mxCell id="prim-memory" value="Memory tiers (see Band 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;strokeWidth=1;fontColor=#4A5568;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="1110" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- HITL primitive -->
        <mxCell id="prim-hitl" value="HITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F80ED;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="1040" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="prim-hitl-body" value="Proposal queue + review workflow.&#10;&#10;● ProposalCreated event&#10;● Decision: approve|reject|defer&#10;● Approve → archive.promote(approver=user)&#10;● Audit trail merges with promotion_history" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="1070" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- Rate budget / cost guard -->
        <mxCell id="prim-budget" value="Rate &amp; cost budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EB5757;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1040" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="prim-budget-body" value="Token-aware sliding window per provider+model.&#10;&#10;● SearchBudget (tokens, dollars, wallclock)&#10;● TokenBucket (per-minute rate cap)&#10;● Emits RateLimitWaited / BudgetExceeded&#10;● Caps concurrency in pair-pass judging" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1070" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- Retrieval index -->
        <mxCell id="prim-retrieval" value="Retrieval index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;strokeWidth=2;fontColor=#2D3748;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1040" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="prim-retrieval-body" value="LanceDB hybrid (vector + BM25), BAAI/bge-base-en-v1.5.&#10;&#10;● Consumed by retrieve() tool (any agent)&#10;● Not a primitive in the spec, but every reference&#10;   agent in this repo uses one." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2D3748;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1070" width="360" height="95" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- BAND 5: EXTERNAL                             -->
        <!-- ============================================ -->
        <mxCell id="band5-label" value="Band 5 &#8212; External (out-of-process)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#718096;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="band5-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1720" height="140" as="geometry" />
        </mxCell>

        <!-- Frozen model -->
        <mxCell id="ext-model" value="Frozen Model (via LiteLLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D3748;strokeColor=#1A202C;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1240" width="540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-model-body" value="Anthropic Claude · OpenAI · Gemini · Bedrock · Ollama&#10;&#10;Provider-agnostic. Never modified.&#10;Helix runs entirely on API calls." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="80" y="1270" width="520" height="70" as="geometry" />
        </mxCell>

        <!-- MCP -->
        <mxCell id="ext-mcp" value="MCP servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A5568;strokeColor=#2D3748;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="1240" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-mcp-body" value="Tools (stdio, HTTP, SSE).&#10;@tool-decorated Python and MCP tools normalize&#10;to the same Tool primitive inside the agent." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1270" width="360" height="70" as="geometry" />
        </mxCell>

        <!-- OTel -->
        <mxCell id="ext-otel" value="Observability stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A5568;strokeColor=#2D3748;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1240" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-otel-body" value="OpenTelemetry wire format.&#10;Plug into: Phoenix, Langfuse, Logfire,&#10;LangSmith, Arize, Braintrust." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1270" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Storage backends -->
        <mxCell id="ext-storage" value="Storage backends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A5568;strokeColor=#2D3748;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1240" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-storage-body" value="SQLite (dev) · Postgres (prod)&#10;LanceDB · pgvector · Turbopuffer&#10;adapters off the same primitives." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1270" width="290" height="70" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- CROSS-CUTTING FLOWS                          -->
        <!-- ============================================ -->

        <!-- Flow 1: Live request (orange) chat-ui → agent → archive.live_champion -->
        <mxCell id="flow1-chat-agent" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2994A;strokeWidth=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chat-ui" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow1-agent-archive" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2994A;strokeWidth=4;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="prim-archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow1-archive-model" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2994A;strokeWidth=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-archive" target="ext-model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 2: Improver round (purple) -->
        <mxCell id="flow2-improver-search" style="endArrow=classic;html=1;rounded=0;strokeColor=#9B51E0;strokeWidth=3;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="improver" target="prim-search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow2-improver-signal" style="endArrow=classic;html=1;rounded=0;strokeColor=#9B51E0;strokeWidth=3;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="improver" target="prim-signal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow2-improver-eval" style="endArrow=classic;html=1;rounded=0;strokeColor=#9B51E0;strokeWidth=3;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="improver" target="prim-eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow2-improver-archive" style="endArrow=classic;html=1;rounded=0;strokeColor=#9B51E0;strokeWidth=3;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="improver" target="prim-archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 3: Promotion (gold) -->
        <!-- Improver emits CandidateWins on bus → hook → archive.promote → Promoted -->
        <mxCell id="flow3-improver-hook" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2C94C;strokeWidth=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;dashed=0;" edge="1" parent="1" source="improver" target="promo-hook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3-improver-hook-label" value="CandidateWins(mode, auto_promote)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#A66100;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="870" y="640" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="flow3-hook-archive" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2C94C;strokeWidth=4;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="promo-hook" target="prim-archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3-hook-archive-label" value="if online: archive.promote(...)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#A66100;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="490" y="820" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Archive promote → Promoted event → next agent request sees it -->
        <mxCell id="flow3-archive-bus" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2C94C;strokeWidth=3;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-archive" target="prim-bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3-archive-bus-label" value="emits Promoted" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#A66100;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="1025" width="120" height="14" as="geometry" />
        </mxCell>

        <!-- Flow 4: Observability (gray, thin) -->
        <!-- All primitives → bus -->
        <mxCell id="flow4-signal-bus" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0AEC0;strokeWidth=1;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-signal" target="prim-bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow4-search-bus" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0AEC0;strokeWidth=1;dashed=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-search" target="prim-bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow4-hook-bus" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0AEC0;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-hook" target="prim-bus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow4-bus-otel" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0AEC0;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-bus" target="ext-otel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow4-bus-dashboard" style="endArrow=classic;html=1;rounded=0;strokeColor=#A0AEC0;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-bus" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 5: HITL (blue) -->
        <mxCell id="flow5-bus-hitl" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F80ED;strokeWidth=2;exitX=0.95;exitY=0.5;exitDx=0;exitDy=0;entryX=0.05;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-bus" target="prim-hitl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow5-hitl-queue" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F80ED;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prim-hitl" target="hitl-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow5-queue-archive" style="endArrow=classic;html=1;rounded=0;strokeColor=#2F80ED;strokeWidth=2;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="hitl-queue" target="prim-archive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Background runner controls Improver -->
        <mxCell id="bg-improver-link" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#9B51E0;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg-runner" target="improver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Chat UI controls bg-runner -->
        <mxCell id="chat-bg-link" style="endArrow=classic;html=1;rounded=0;strokeColor=#F2994A;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chat-ui" target="bg-runner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Agent reads memory -->
        <mxCell id="agent-memory-link" style="endArrow=classic;html=1;rounded=0;strokeColor=#27AE60;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="trajectory" target="memory-cluster">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- ANNOTATIONS / CALLOUTS                       -->
        <!-- ============================================ -->

        <!-- Callout 1: Layer rule -->
        <mxCell id="callout-layer-rule" value="⚠ Layer rule&#10;ONLINE refused at construction for L3 / L4 artifacts.&#10;DESIGN_NOTES.md §10." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEAEA;strokeColor=#EB5757;fontColor=#742A2A;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="1290" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Callout 2: Two events -->
        <mxCell id="callout-two-events" value="📡 Two distinct events&#10;CandidateWins ≠ Promoted.&#10;Offline rounds produce CandidateWins only;&#10;Promoted fires later when a human acts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#F2C94C;fontColor=#5C4B00;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1240" y="800" width="290" height="60" as="geometry" />
        </mxCell>

        <!-- Callout 3: Genesis fallback -->
        <mxCell id="callout-genesis" value="✅ Genesis fallback&#10;live_champion(id) returns None until&#10;first promote() &#8212; agent falls back&#10;to genesis prompt from the spec." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#2F80ED;fontColor=#1A4480;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="490" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- LEGEND (top-right)                           -->
        <!-- ============================================ -->
        <mxCell id="legend-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1450" y="60" width="310" height="46" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Flows" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#2D3748;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1455" y="60" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-orange" value="━ live request" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#F2994A;fontStyle=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1455" y="82" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="legend-purple" value="━ improvement round" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#9B51E0;fontStyle=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1560" y="82" width="130" height="18" as="geometry" />
        </mxCell>
        <mxCell id="legend-gold" value="━ promotion" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#F2C94C;fontStyle=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1455" y="98" width="100" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-blue" value="━ HITL" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2F80ED;fontStyle=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1560" y="98" width="60" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-gray" value="┄ observability" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#A0AEC0;fontStyle=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1640" y="98" width="120" height="14" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
